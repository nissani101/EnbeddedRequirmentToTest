# .gitignore for .NET and Visual Studio projects

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Nested projects
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]est[Rr]esults/

# Visual Studio 2015/2017 cache directory
.vs/

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if using NuGet Version 1
# **/packages/

# Temporary files
*.tmp
*.bak
*.swp
*~
_ReSharper*/
[Tt]est[Rr]esult*/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
