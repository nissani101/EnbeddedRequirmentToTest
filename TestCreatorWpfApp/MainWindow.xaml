<Window x:Class="TestCreatorWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Test Table Creator" 
        WindowState="Maximized"
        MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App Logo -->
            <StackPanel Grid.Row="0" Margin="20,30,20,40">
                <TextBlock Text="TEST ENGINE" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Management Console" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Navigation Items -->
            <StackPanel Grid.Row="1">
                <Button x:Name="navDashboard" Style="{StaticResource SidebarItem}" Click="nav_Click" Tag="Dashboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                        <TextBlock Text="Dashboard" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="navSettings" Style="{StaticResource SidebarItem}" Click="nav_Click" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                        <TextBlock Text="Settings" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="navLogic" Style="{StaticResource SidebarItem}" Click="nav_Click" Tag="Logic">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                        <TextBlock Text="Logic to Permutation" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="navRecordTesting" Style="{StaticResource SidebarItem}" Click="nav_Click" Tag="RecordTesting">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                        <TextBlock Text="Record Testing" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="navHistory" Style="{StaticResource SidebarItem}" Click="nav_Click" Tag="History">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                        <TextBlock Text="History" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="2" Background="#242427" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="32" Height="32" Fill="{StaticResource AccentPurple}"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Administrator" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="lblDbStatus" Text="DB: Connecting..." Foreground="Orange" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dashboard View -->
            <Grid x:Name="viewDashboard" Margin="30" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="System Dashboard" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Overview of testing status and system health." Foreground="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,25"/>
                    <Border Style="{StaticResource CardBorder}">
                        <TextBlock Text="Dashboard overview coming soon..." Foreground="{StaticResource SecondaryText}" FontStyle="Italic"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Logic to Permutation View -->
            <ScrollViewer x:Name="viewLogic" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Logic to Permutation" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Configure and run automated test permutations." Foreground="{StaticResource SecondaryText}" FontSize="14"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Config, Requirements and System Log -->
                        <StackPanel Grid.Column="0" Width="450" Margin="0,0,20,0">
                            <!-- Configuration Card -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Label Content="Requirements Document (.docx)" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold"/>
                                    <DockPanel Margin="0,0,0,15">
                                        <Button DockPanel.Dock="Right" Content="Browse" Width="80" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" x:Name="btnBrowseReq" Click="btnBrowseReq_Click"/>
                                        <TextBox x:Name="txtReq"/>
                                    </DockPanel>

                                    <Label FontWeight="SemiBold">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="Content" Value="Test Parameters (.xlsx / .json)"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentPurple}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkLoadFromSql}" Value="True">
                                                        <Setter Property="Content" Value="Test Parameters (DB)"/>
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                    <DockPanel Margin="0,0,0,15">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkLoadFromSql}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Button DockPanel.Dock="Right" Content="Browse" Width="80" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" x:Name="btnBrowseParams" Click="btnBrowseParams_Click"/>
                                        <TextBox x:Name="txtParams"/>
                                    </DockPanel>

                                    <Label Content="Output Destination (.xlsx)" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold"/>
                                    <DockPanel Margin="0,0,0,15">
                                        <Button DockPanel.Dock="Right" Content="Select" Width="80" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" x:Name="btnBrowseOutput" Click="btnBrowseOutput_Click"/>
                                        <TextBox x:Name="txtOutput"/>
                                    </DockPanel>

                                    <TextBlock Margin="0,5,0,5" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mode: UDP"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=rbTcp}" Value="True">
                                                        <Setter Property="Text" Value="Mode: TCP"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox x:Name="chkLoadFromSql" Content="Load Parameters from SQL" VerticalAlignment="Center" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold" Margin="0,5,0,15"/>

                                    <StackPanel Orientation="Vertical">
                                        <Button Content="START CREATE &amp; EXECUTE" Style="{StaticResource SuccessButton}" Margin="0,0,0,10" x:Name="btnExecute" Click="btnExecute_Click"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="Create Test Only" Style="{StaticResource PrimaryButton}" Background="#475569" Margin="0,0,5,0" x:Name="btnCreateOnly" Click="btnCreateOnly_Click"/>
                                            <Button Content="Test Link" Style="{StaticResource PrimaryButton}" Background="#0284C7" Margin="5,0,0,0" x:Name="btnTestEcho" Click="btnTestEcho_Click"/>    
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Loaded Requirements Card -->
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Loaded Requirements" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                        <ListBox x:Name="lstRequirements" Height="100" BorderThickness="0" Background="#FAFAFA" FontSize="12">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="5,2"><TextBlock Text="{Binding}" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold" TextWrapping="Wrap" FontFamily="Consolas"/></Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- System Event Log -->
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="System Event Log" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                        <ListBox x:Name="lstSystemLog" Height="150" BorderThickness="0" Background="#FAFAFA" FontSize="12">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="5,2"><TextBlock Text="{Binding}" Foreground="#455A64" FontFamily="Consolas"/></Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Execution Monitor -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" MinWidth="600">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                                    <Button DockPanel.Dock="Right" Content="Run Selected" Style="{StaticResource PrimaryButton}" Height="30" Width="120" FontSize="12" x:Name="btnRunSelected" Click="btnRunSelected_Click"/>
                                    <TextBlock Text="Execution Real-time Monitor" FontWeight="Bold" FontSize="16" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </DockPanel>

                                <ProgressBar Grid.Row="1" x:Name="pbTotal" Height="10" Foreground="{StaticResource AccentPurple}" Background="#E2E8F0" BorderThickness="0" Visibility="Collapsed" Maximum="100" Value="0" Margin="0,0,0,15"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Side: ListBox -->
                                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,15,0">
                                        <ListBox x:Name="lstPreview" BorderThickness="0" Background="#F8FAFC" SelectionMode="Extended">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="itemBorder" Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Fill="{Binding RowColor}" VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#334155" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RowColor}" Value="Green"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#065F46"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding RowColor}" Value="Red"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#991B1B"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ProgressBar Grid.Column="2" Height="4" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" Margin="10,0,15,0" Foreground="{Binding RowColor}" Background="#E2E8F0" BorderThickness="0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Progress}" Value="100"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="itemBorder" Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/></Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <!-- Right Side: 3D Chart -->
                                    <Border Grid.Column="1" x:Name="gridChart" Visibility="Collapsed" CornerRadius="8" Background="#1E293B" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Viewport3D Grid.Row="0" x:Name="view3D" ClipToBounds="True">
                                                <Viewport3D.Camera>
                                                    <PerspectiveCamera Position="10, 8, 14" LookDirection="-1, -0.6, -1.2" UpDirection="0, 1, 0" FieldOfView="45" />
                                                </Viewport3D.Camera>
                                                <ModelVisual3D>
                                                    <ModelVisual3D.Content>
                                                        <Model3DGroup>
                                                            <AmbientLight Color="#666666" /><DirectionalLight Color="#FFFFFF" Direction="-2,-3,-1" /><DirectionalLight Color="#999999" Direction="2,1,1" />

                                                            <!-- Base Stage -->
                                                            <GeometryModel3D>
                                                                <GeometryModel3D.Geometry><MeshGeometry3D Positions="3.5,0,1.5 3.5,0,-1.5 -3.5,0,-1.5 -3.5,0,1.5 3.5,-0.2,1.5 3.5,-0.2,-1.5 -3.5,-0.2,-1.5 -3.5,-0.2,1.5" TriangleIndices="0 2 1 0 3 2 4 5 6 4 6 7 0 1 5 0 5 4 1 2 6 1 6 5 2 3 7 2 7 6 3 0 4 3 4 7" /></GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material><DiffuseMaterial Brush="#334155" /></GeometryModel3D.Material>
                                                            </GeometryModel3D>

                                                            <!-- Pass Pillar (Green) -->
                                                            <GeometryModel3D x:Name="modelPass">
                                                                <GeometryModel3D.Geometry><MeshGeometry3D Positions="0.5,0,0 0.35,0,0.35 0,0,0.5 -0.35,0,0.35 -0.5,0,0 -0.35,0,-0.35 0,0,-0.5 0.35,0,-0.35 0.5,1,0 0.35,1,0.35 0,1,0.5 -0.35,1,0.35 -0.5,1,0 -0.35,1,-0.35 0,1,-0.5 0.35,1,-0.35" TriangleIndices="0 8 9 0 9 1 1 9 10 1 10 2 2 10 11 2 11 3 3 11 12 3 12 4 4 12 13 4 13 5 5 13 14 5 14 6 6 14 15 6 15 7 7 15 8 7 8 0 8 10 9 8 11 10 8 12 11 8 13 12 8 14 13 8 15 14" /></GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material><MaterialGroup><DiffuseMaterial Brush="#10B981" /><SpecularMaterial Brush="White" SpecularPower="40" /></MaterialGroup></GeometryModel3D.Material>
                                                                <GeometryModel3D.Transform><Transform3DGroup><ScaleTransform3D x:Name="scalePass" ScaleX="1" ScaleY="1" ScaleZ="1" /><TranslateTransform3D OffsetX="-2.1" /></Transform3DGroup></GeometryModel3D.Transform>
                                                            </GeometryModel3D>

                                                            <!-- Warning Pillar (Amber) -->
                                                            <GeometryModel3D x:Name="modelWarn">
                                                                <GeometryModel3D.Geometry><MeshGeometry3D Positions="0.5,0,0 0.35,0,0.35 0,0,0.5 -0.35,0,0.35 -0.5,0,0 -0.35,0,-0.35 0,0,-0.5 0.35,0,-0.35 0.5,1,0 0.35,1,0.35 0,1,0.5 -0.35,1,0.35 -0.5,1,0 -0.35,1,-0.35 0,1,-0.5 0.35,1,-0.35" TriangleIndices="0 8 9 0 9 1 1 9 10 1 10 2 2 10 11 2 11 3 3 11 12 3 12 4 4 12 13 4 13 5 5 13 14 5 14 6 6 14 15 6 15 7 7 15 8 7 8 0 8 10 9 8 11 10 8 12 11 8 13 12 8 14 13 8 15 14" /></GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material><MaterialGroup><DiffuseMaterial Brush="#F59E0B" /><SpecularMaterial Brush="White" SpecularPower="40" /></MaterialGroup></GeometryModel3D.Material>
                                                                <GeometryModel3D.Transform><Transform3DGroup><ScaleTransform3D x:Name="scaleWarn" ScaleX="1" ScaleY="1" ScaleZ="1" /><TranslateTransform3D OffsetX="-0.7" /></Transform3DGroup></GeometryModel3D.Transform>
                                                            </GeometryModel3D>

                                                            <!-- Fail Pillar (Red) -->
                                                            <GeometryModel3D x:Name="modelFail">
                                                                <GeometryModel3D.Geometry><MeshGeometry3D Positions="0.5,0,0 0.35,0,0.35 0,0,0.5 -0.35,0,0.35 -0.5,0,0 -0.35,0,-0.35 0,0,-0.5 0.35,0,-0.35 0.5,1,0 0.35,1,0.35 0,1,0.5 -0.35,1,0.35 -0.5,1,0 -0.35,1,-0.35 0,1,-0.5 0.35,1,-0.35" TriangleIndices="0 8 9 0 9 1 1 9 10 1 10 2 2 10 11 2 11 3 3 11 12 3 12 4 4 12 13 4 13 5 5 13 14 5 14 6 6 14 15 6 15 7 7 15 8 7 8 0 8 10 9 8 11 10 8 12 11 8 13 12 8 14 13 8 15 14" /></GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material><MaterialGroup><DiffuseMaterial Brush="#EF4444" /><SpecularMaterial Brush="White" SpecularPower="40" /></MaterialGroup></GeometryModel3D.Material>
                                                                <GeometryModel3D.Transform><Transform3DGroup><ScaleTransform3D x:Name="scaleFail" ScaleX="1" ScaleY="1" ScaleZ="1" /><TranslateTransform3D OffsetX="0.7" /></Transform3DGroup></GeometryModel3D.Transform>
                                                            </GeometryModel3D>

                                                            <!-- Not Run Pillar (Slate) -->
                                                            <GeometryModel3D x:Name="modelNotRun">
                                                                <GeometryModel3D.Geometry><MeshGeometry3D Positions="0.5,0,0 0.35,0,0.35 0,0,0.5 -0.35,0,0.35 -0.5,0,0 -0.35,0,-0.35 0,0,-0.5 0.35,0,-0.35 0.5,1,0 0.35,1,0.35 0,1,0.5 -0.35,1,0.35 -0.5,1,0 -0.35,1,-0.35 0,1,-0.5 0.35,1,-0.35" TriangleIndices="0 8 9 0 9 1 1 9 10 1 10 2 2 10 11 2 11 3 3 11 12 3 12 4 4 12 13 4 13 5 5 13 14 5 14 6 6 14 15 6 15 7 7 15 8 7 8 0 8 10 9 8 11 10 8 12 11 8 13 12 8 14 13 8 15 14" /></GeometryModel3D.Geometry>
                                                                <GeometryModel3D.Material><MaterialGroup><DiffuseMaterial Brush="#94A3B8" /><SpecularMaterial Brush="White" SpecularPower="40" /></MaterialGroup></GeometryModel3D.Material>
                                                                <GeometryModel3D.Transform><Transform3DGroup><ScaleTransform3D x:Name="scaleNotRun" ScaleX="1" ScaleY="1" ScaleZ="1" /><TranslateTransform3D OffsetX="2.1" /></Transform3DGroup></GeometryModel3D.Transform>
                                                            </GeometryModel3D>
                                                        </Model3DGroup>
                                                    </ModelVisual3D.Content>
                                                </ModelVisual3D>
                                            </Viewport3D>
                                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
                                                <TextBlock x:Name="lblPassCount" Text="PASS: 0" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="lblWarnCount" Text="WARN: 0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="lblFailCount" Text="FAIL: 0" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="lblNotRunCount" Text="NOT RUN: 0" Foreground="#94A3B8" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Record Testing View -->
            <Grid x:Name="viewRecordTesting" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,25">
                    <TextBlock Text="Record Testing &amp; Analysis" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Monitor real-time telemetry and explore database structures." Foreground="{StaticResource SecondaryText}" FontSize="14"/>
                </StackPanel>

                <!-- Left Column: Input and Database -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="Requirement to test" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" x:Name="txtRequirementToTest" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Clear" Width="100" Style="{StaticResource PrimaryButton}" Background="#64748B" Margin="0,0,10,0" x:Name="btnClearRecord" Click="btnClearRecord_Click"/>
                            <Button Content="Query" Width="100" Style="{StaticResource PrimaryButton}" x:Name="btnQueryRecord" Click="btnQueryRecord_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Database tables" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,10"/>
                        <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <TreeView x:Name="treeDbSchema" BorderThickness="0" Background="#FAFAFA">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DbCheckBox_Checked" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{Binding IsSelectable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#64748B">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Column">
                                                                <Setter Property="Text" Value="&#xE8A5;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Column: Telemetry Graphs -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="20,0,0,0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Telemetry Analysis" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,15"/>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="180"/>
                            </Grid.RowDefinitions>

                            <!-- Global Overview Chart -->
                            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                                <Grid>
                                    <TextBlock Text="Parameters Overview (All T-Series)" FontSize="10" Foreground="Gray" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    <lvc:CartesianChart x:Name="chartGlobal" LegendLocation="Bottom" Hoverable="True">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Title="Samples" ShowLabels="True"/>
                                        </lvc:CartesianChart.AxisX>
                                    </lvc:CartesianChart>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="lstTelemetry" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ColumnName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentPurple}"/>
                                                    <TextBlock Text="{Binding TableName}" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Min: " FontSize="9" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding MinValue}" FontSize="9" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" Max: " FontSize="9" Foreground="Gray" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding MaxValue}" FontSize="9" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1" Height="60" Margin="15,0" Background="White" CornerRadius="4" BorderBrush="#F1F5F9" BorderThickness="1">
                                                    <lvc:CartesianChart Series="{Binding ChartSeries}" Hoverable="True">
                                                        <lvc:CartesianChart.AxisX>
                                                            <lvc:Axis ShowLabels="False" IsMerged="True"/>
                                                        </lvc:CartesianChart.AxisX>
                                                        <lvc:CartesianChart.AxisY>
                                                            <lvc:Axis ShowLabels="False" IsMerged="True"/>
                                                        </lvc:CartesianChart.AxisY>
                                                    </lvc:CartesianChart>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="50">
                                                    <TextBlock Text="Current" FontSize="8" Foreground="Gray" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Normal"><Setter Property="Foreground" Value="Green"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Alert"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#F1F5F9" Margin="0,5"/>

                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Table Records Preview" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,5,0,10"/>
                                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <DataGrid x:Name="gridTableRecords" AutoGenerateColumns="True" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                              AlternatingRowBackground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column" 
                                              FontSize="11" RowHeight="25" SelectedCellsChanged="gridTableRecords_SelectedCellsChanged">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="10,5"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- History View -->
            <Grid x:Name="viewHistory" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Action History" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Recent operations performed by the engine." Foreground="{StaticResource SecondaryText}" FontSize="14"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Width="650" HorizontalAlignment="Left">
                    <ListBox x:Name="lstHistory" BorderThickness="0" Background="Transparent" FontSize="14" MinHeight="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,15" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding}" Foreground="#334155"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Button Grid.Row="2" Content="Clear History" Style="{StaticResource PrimaryButton}" Background="#EF4444" Width="150" HorizontalAlignment="Left" x:Name="btnClearHistory" Click="btnClearHistory_Click"/>
            </Grid>

            <!-- Settings View -->
            <ScrollViewer x:Name="viewSettings" Margin="30" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="System Settings" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Configure network parameters and database connection." Foreground="{StaticResource SecondaryText}" FontSize="14"/>
                    </StackPanel>

                    <!-- Protocol Selection Card -->
                    <Border Style="{StaticResource CardBorder}" Width="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Active protocol selection" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,15"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbUdp" Content="UDP Mode" IsChecked="True" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold" Margin="0,0,20,0" Checked="Protocol_Checked"/>
                                <RadioButton x:Name="rbTcp" Content="TCP Mode" Foreground="{StaticResource AccentPurple}" FontWeight="SemiBold" Checked="Protocol_Checked"/>
                            </StackPanel>
                            <TextBlock Text="Selecting a protocol will automatically start its terminal nodes and close the other." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <!-- UDP Settings Card -->
                        <Border Style="{StaticResource CardBorder}" Width="350" HorizontalAlignment="Left" Margin="0,0,20,0">
                            <StackPanel>
                                <TextBlock Text="Udp configuration" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,15"/>
                                <Label Content="Server IP Address"/>
                                <TextBox x:Name="txtUdpIp" Margin="0,0,0,15"/>

                                <Label Content="Server Port"/>
                                <TextBox x:Name="txtUdpPort" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Connect" Style="{StaticResource SuccessButton}" Click="btnSaveUdpSettings_Click" Width="120" Margin="0,0,10,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtUdpSuccess" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="Green" FontSize="18" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,5,0" ToolTip="Connection Successful"/>
                                        <TextBlock x:Name="txtUdpError" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="18" FontWeight="Bold" Visibility="Collapsed" ToolTip="Connection Failed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TCP Settings Card -->
                        <Border Style="{StaticResource CardBorder}" Width="350" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Tcp configuration" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,15"/>
                                <Label Content="Server IP Address"/>
                                <TextBox x:Name="txtTcpIp" Margin="0,0,0,15"/>

                                <Label Content="Server Port"/>
                                <TextBox x:Name="txtTcpPort" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Connect" Style="{StaticResource SuccessButton}" Click="btnSaveTcpSettings_Click" Background="{StaticResource AccentPurple}" Width="120" Margin="0,0,10,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtTcpSuccess" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="Green" FontSize="18" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,5,0" ToolTip="Connection Successful"/>
                                        <TextBlock x:Name="txtTcpError" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="18" FontWeight="Bold" Visibility="Collapsed" ToolTip="Connection Failed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Database Settings Card -->
                    <Border Style="{StaticResource CardBorder}" Width="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Database" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,15"/>
                            <Label Content="Connection string"/>
                            <ComboBox x:Name="cmbDbConnectionString" IsEditable="True" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Connect" Style="{StaticResource SuccessButton}" Click="btnSaveDbSettings_Click" Background="#455A64" Width="180" Margin="0,0,10,0"/>
                                <Button Content="Test Connection" Style="{StaticResource PrimaryButton}" Click="btnTestDbConnection_Click" Background="#607D8B" Width="180"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtDbSuccess" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="Green" FontSize="20" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,10,0" ToolTip="Connection Successful"/>
                                    <TextBlock x:Name="txtDbError" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="20" FontWeight="Bold" Visibility="Collapsed" ToolTip="Connection Failed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Global Footer -->
            <Button Grid.Row="1" Content="Exit Application" Style="{StaticResource PrimaryButton}" Background="Transparent" Foreground="#64748B" x:Name="btnClose" Click="btnClose_Click" HorizontalAlignment="Right" Margin="30"/>
        </Grid>
    </Grid>
</Window>